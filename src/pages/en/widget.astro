---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/travel-vaccine-checker/" title="Travel vaccines by itinerary, with yellow fever rules and prices" width="100%" height="1000" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the travel vaccine checker on your site, free" description="Schools, libraries, study-abroad offices and travel clubs can embed the travel vaccine checker with one iframe line. No cookie, no tracking, no booking form." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the trip checker', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the trip checker' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the travel vaccine checker</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When CDC updates a destination page and we reload it, the embedded checker follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the checker visible, do not alter the frame, and do not place it next to a booking form or a sales offer for vaccines. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Vaccines for up to three countries, yellow fever by border, prices</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/travel-vaccine-checker/" title="Travel vaccines by itinerary, with yellow fever rules and prices" width="100%" height="1000" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
